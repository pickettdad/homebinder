{
  "name": "housesteady-field-assistant",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/gen-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-icons.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
